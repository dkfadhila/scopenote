# Copy to .env for local use. Real values belong only in .env or Render's secret UI.
# Never prefix secrets with VITE_. Never paste secrets into chat or an article.
PORT=3001
APP_ORIGIN=http://127.0.0.1:5178
WORKSPACE_PASSWORD=
ACCOUNT_MODE=true
AI_DAILY_LIMIT=50
# Optional transactional email. Use an address on your verified Resend domain.
RESEND_API_KEY=
EMAIL_FROM=
SESSION_SECRET=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
MONGODB_URI=
MONGODB_DATABASE=scopenote
SENTRY_DSN=
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
# AllScale: optional server-only connectivity setup. No checkout enabled yet.
ALLSCALE_API_KEY=
ALLSCALE_API_SECRET=
ALLSCALE_CHECKOUT_ENABLED=false
